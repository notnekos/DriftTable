#include <windows.h>

1 ICON "DriftTable.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "DriftTable.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "DriftTable - infinite desktop canvas"
            VALUE "ProductName", "DriftTable"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
